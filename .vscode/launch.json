    "version": "0.2.0",
    "configurations": [
        {
            "name": "Abrir no Chrome",
            "type": "chrome",
            "request": "launch",
            "file": "${workspaceFolder}/public/index.html"
        },
        {
            "name": "Abrir no Edge",
            "type": "msedge",
            "request": "launch",
            "file": "${workspaceFolder}/public/index.html"
        },
        {
            "name": "Servidor Local (http://localhost:8080)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/public"
        }
    ]
}